   "source": [
    "Q02. Write code to replace the odd numbers by -1 in the array created by using\n",
    "random.randint( 1 , 50,20)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 2,
   "id": "eec85251",
   "metadata": {},
   "outputs": [],
   "source": [
    "import numpy as np"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 3,
   "id": "3297945d",
   "metadata": {},
   "outputs": [
    {
     "data": {
      "text/plain": [
       "array([31, 15,  5, 28, 42, 35, 20, 35, 13, 40,  2, 15, 22, 32, 17, 29, 13,\n",
       "       11, 40, 33], dtype=int32)"
      ]
     },
     "execution_count": 3,
     "metadata": {},
     "output_type": "execute_result"
    }
   ],
   "source": [
    "arr =np.random.randint(1,50,20)\n",
    "arr"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 4,
   "id": "abbd767b",
   "metadata": {},
   "outputs": [
    {
     "data": {
      "text/plain": [
       "array([-1, -1, -1, 28, 42, -1, 20, -1, -1, 40,  2, -1, 22, 32, -1, -1, -1,\n",
       "       -1, 40, -1], dtype=int32)"
      ]
     },
     "execution_count": 4,
     "metadata": {},
     "output_type": "execute_result"
    }
   ],
   "source": [
    "arr[arr % 2 !=0]=-1\n",
    "arr"
   ]
  },
